using System;

class AccountEventArgs
{
    public string Message { get; }
    public int Sum { get; }

    public AccountEventArgs(string message, int sum)
    {
        Message = message;
        Sum = sum;
    }
}

interface IReportable
{
    DateTime CreatedAt { get; }
    string GetReportInfo();
}

interface IAccountControl
{
    int Balance { get; }
    void Put(int sum);
    void Take(int sum);
    event Action<object, AccountEventArgs> TransactionOccurred;
}

class BankAccount : IAccountControl, IReportable
{
    public int Balance { get; private set; }
    public DateTime CreatedAt { get; }

    public event Action<object, AccountEventArgs>? TransactionOccurred;

    public BankAccount(int balance, DateTime createdAt)
    {
        Balance = balance;
        CreatedAt = createdAt;
    }

    public void Put(int sum)
    {
        Balance += sum;
        TransactionOccurred?.Invoke(this, new AccountEventArgs("Пополнение счета", sum));
    }

    public void Take(int sum)
    {
        if (Balance >= sum)
        {
            Balance -= sum;
            TransactionOccurred?.Invoke(this, new AccountEventArgs("Снятие со счета", sum));
        }
        else
        {
            TransactionOccurred?.Invoke(this, new AccountEventArgs("Недостаточно средств", 0));
        }
    }

    public string GetReportInfo()
    {
        return "Счет открыт: " + CreatedAt.ToShortDateString() + ", баланс: " + Balance + " руб.";
    }
}

class Program
{
    static void PrintMessage(object sender, AccountEventArgs e)
    {
        Console.WriteLine("Обработчик 1: " + e.Message);
    }

    static void Main()
    {
        BankAccount account = new BankAccount(1000, DateTime.Now);
        IAccountControl control = account;

        control.TransactionOccurred += PrintMessage;
        control.TransactionOccurred += (sender, e) =>
            Console.WriteLine("Обработчик 2: " + e.Message + ", сумма: " + e.Sum + " руб.");

        control.Put(500);
        control.Take(300);
        control.Take(2000);

        control.TransactionOccurred -= PrintMessage;
        Console.WriteLine("--- после отписки ---");
        control.Put(100);

        IReportable report = (IReportable)control;
        Console.WriteLine(report.GetReportInfo());

        Console.ReadLine();
    }
}
